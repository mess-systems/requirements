{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile: сквозной набор или профиль класса решений",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "version", "status", "owner", "items"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "kind": {"enum": ["set", "class"]},
    "title": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "proposed", "approved", "deprecated"]},
    "owner": {"type": "string", "pattern": "^role-[a-z0-9-]+$"},
    "description": {"type": "string"},
    "blueprint": {"type": "string", "description": "папка blueprint; для профиля класса имя профиля = имя папки"},
    "blueprint_status": {"enum": ["published", "draft", "none"]},
    "includes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+$"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[A-Z]{2,6}-[0-9]{3}$"},
          "level": {"enum": ["MUST", "SHOULD", "MAY"]},
          "stage": {"type": "integer", "minimum": 1},
          "params": {"type": "object"},
          "note": {"type": "string"}
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "reason"],
                "properties": {"id": {"type": "string"}, "reason": {"type": "string"}}}
    },
    "backlog": {
      "type": "array", "description": "что ещё не оформлено типовыми требованиями",
      "items": {"type": "object", "additionalProperties": false, "required": ["source", "note"],
                "properties": {"source": {"type": "string"}, "note": {"type": "string"}}}
    }
  }
}
