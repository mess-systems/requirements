{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement front matter",
  "description": "Перечисления id/type/scope/status/priority дополнительно сверяются с reqs.config.yaml в validate.py, чтобы схема не зависела от префиксов проекта.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "priority", "owner", "scope", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[A-Z]{2,4}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "type": {"type": "string"},
    "status": {"type": "string"},
    "priority": {"type": "string"},
    "owner": {"type": "string", "description": "роль или команда, не ФИО"},
    "scope": {"type": "string"},
    "category": {"type": "string"},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hypothesis": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1},
    "links": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "adr": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "verified_by": {"type": "array", "items": {"type": "string"}},
        "docs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
