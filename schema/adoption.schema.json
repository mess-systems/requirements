{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adoption.yaml: какие типовые требования проект принимает и как",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog", "profiles", "items"],
  "properties": {
    "catalog": {
      "type": "object", "additionalProperties": false, "required": ["repo", "release"],
      "properties": {
        "repo": {"type": "string"},
        "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "root": {"type": "string", "description": "корень проекта в reqs.config.yaml, по умолчанию requirements"},
    "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "mode"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[A-Z]{2,6}-[0-9]{3}$"},
          "mode": {"enum": ["inherit", "refine", "waive"]},
          "priority": {"enum": ["M", "S", "C", "W"]},
          "params": {"type": "object"},
          "by": {"type": "array", "items": {"type": "string"}, "description": "refine: требования проекта, которые уточняют типовое"},
          "reason": {"type": "string"},
          "owner": {"type": "string", "pattern": "^role-[a-z0-9-]+$"},
          "review": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "compensated_by": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"mode": {"const": "refine"}}}, "then": {"required": ["by"]}},
          {"if": {"properties": {"mode": {"const": "waive"}}}, "then": {"required": ["reason", "owner", "review"]}}
        ]
      }
    }
  }
}
